# Optional overrides — highlevel-mcp has no required env vars.
# Authentication is per-request via two headers (never via env vars):
#   X-HighLevel-Private-Token   HighLevel Private Integration Token
#                                (sub-account Settings -> Private Integrations).
#                                Forwarded as "Authorization: Bearer <token>" to
#                                the HighLevel API.
#   X-HighLevel-Location-Id     The HighLevel sub-account (Location) ID the
#                                token is scoped to.

MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0
